{
	"name": "back-end",
	"version": "2.1.5",
	"private": true,
	"description": "Minimal Express API for the vitesse-nuxt monorepo template.",
	"type": "module",
	"packageManager": "npm@12.2.1",
	"engines": {
		"node": ">=24.22.1 <25",
		"npm": ">=12.2.1 <13"
	},
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"lint": "eslint \"{src,test}/**/*.{js,ts}\"",
		"lint-fix": "eslint \"{src,test}/**/*.{js,ts}\" --fix"
	},
	"keywords": [],
	"author": "Jacob Anderson",
	"license": "MIT",
	"dependencies": {
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0"
	},
	"overrides": {
		"nanoid@^3": "3.3.18",
		"qs": "6.17.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/supertest": "^7.2.1",
		"globals": "^17.13.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
